{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=attendance_db;User=root;Password=YOUR_PASSWORD_HERE;"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "StudentAttendanceSystem",
    "Audience": "StudentAttendanceApp",
    "ExpiryInMinutes": 60
  },
  "BrevoSettings": {
    "ApiKey": "YOUR_BREVO_API_KEY_HERE",
    "SenderEmail": "noreply@attendance-system.com",
    "SenderName": "Student Attendance System"
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
